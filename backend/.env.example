# Local server
PORT=8080

# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindcare
DB_USER=postgres
DB_PASSWORD=change-me

# Use a random value of at least 32 bytes in every non-local environment.
JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separate multiple exact origins. Do not add trailing slashes.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174
